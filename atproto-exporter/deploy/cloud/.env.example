# Grafana Cloud Prometheus remote_write credentials.
# In Grafana Cloud: your stack -> Prometheus -> "Send Metrics" shows the URL and
# username; create an access policy token with the metrics:write scope for the
# password. Copy this file to .env and fill in the three values.

# The remote_write push endpoint, e.g.
# https://prometheus-prod-24-prod-eu-west-2.grafana.net/api/prom/push
GC_PROM_URL=

# Your Prometheus instance / user ID (a number).
GC_PROM_USER=

# A Grafana Cloud access policy token with the metrics push scope.
GC_PROM_TOKEN=
